// Phase 1-2: ドメインモデルを追加。Auth.js テーブルは Phase 1-1 から維持。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================
// Enums
// =====================

enum StaffRole {
  ADMIN
  CONSULTANT
  SALES
  VIEWER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Rank {
  S
  A
  B
  C
  D
}

enum ApplicantStatus {
  RECEIVED
  DIAGNOSED
  SKILL_SHEET_INPROGRESS
  SKILL_SHEET_DONE
  INTERVIEW_DONE
  SALES_READY
  IN_INTRODUCTION
  CONTRACTED
  REJECTED
}

enum FacilityCategory {
  HOSPITAL_ACUTE
  HOSPITAL_GENERAL
  CLINIC
  DAYCARE_ELDERLY
  REHAB_DAY
  HOMEVISIT_NURSE
  HOMEVISIT_NURSE_PSYCHIATRY
  HOMEVISIT_CARE
  DAYCARE_DISABILITY
  HOMEVISIT_DISABILITY
  GROUP_HOME_DISABILITY
}

// =====================
// Phase 6: 内部システム完成化用 enum
// =====================

enum JobPosition {
  NURSE
  CARE_WORKER
  PT_OT_ST
  SOCIAL_WORKER
  CARE_MANAGER
  OTHER
}

enum EmploymentType {
  DISPATCH
  DIRECT
  TEMP_TO_PERM
  PART_TIME
}

enum JobOrderStatus {
  OPEN
  HOLD
  FILLED
  CLOSED
}

enum JobOrderUrgency {
  NORMAL
  URGENT
  CRITICAL
}

enum ContractType {
  DISPATCH_AGREEMENT
  INTRODUCTION_FEE
  TEMP_TO_PERM
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  EXPIRED
  CANCELLED
}

enum ESignProvider {
  MOCK
  CLOUDSIGN
  GMO_SIGN
}

enum PlacementFeeStatus {
  PENDING
  INVOICED
  PAID
  REFUNDED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  VOID
}

enum MyNumberPurpose {
  WITHHOLDING
  SOCIAL_INSURANCE
  EMPLOYMENT_INSURANCE
}

enum MyNumberAccessAction {
  VIEW
  UPDATE
  DELETE
  EXPORT
}

// v1.8: ナーチャシナリオ
enum NurtureTrigger {
  FAX_SENT_NO_REPLY
  SKILL_SHEET_INVITED_NO_SUBMIT
  INTEREST_RECEIVED
  PLACEMENT_1MONTH
  PLACEMENT_3MONTH
}

enum NurtureStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  PAUSED
}

enum NurtureStepKind {
  EMAIL
  STAFF_TODO
  WAIT
}

// v1.9: AI 出力レビューワークフロー (Responsible AI)
enum AiReviewKind {
  DIAGNOSIS
  FAX_COVER
  EMAIL_DRAFT
  INTERVIEW_SUMMARY
}

enum AiReviewStatus {
  PENDING
  APPROVED
  EDITED
  REJECTED
}

// =====================
// Auth.js (NextAuth v5) 標準スキーマ
// 参考: https://authjs.dev/getting-started/adapters/prisma
// =====================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // Credentials Provider 用。Magic Link のみの利用者は null
  accounts      Account[]
  sessions      Session[]
  staff         Staff?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =====================
// 社内スタッフ
// =====================

// 社内スタッフの業務属性。User と 1:1。
model Staff {
  id                 String              @id @default(cuid())
  userId             String              @unique
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  email              String              @unique
  name               String
  role               StaffRole           @default(VIEWER)
  auditLogs          AuditLog[]
  // Phase 6: append-only ハッシュチェーン監査ログ + マイナンバーアクセスログ
  auditEvents        AuditEvent[]
  myNumberAccessLogs MyNumberAccessLog[]
  // v1.9: AI 出力レビューの担当
  aiReviews          AiReview[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

// =====================
// 求職者ドメイン
// =====================

model Applicant {
  id                String             @id @default(cuid())
  lastName          String
  firstName         String
  lastNameKana      String
  firstNameKana     String
  birthDate         DateTime
  gender            Gender
  email             String             @unique
  phone             String
  nationality       String?
  language          String?            @default("ja")
  // Phase 5: 在留資格 (1:1)。在留資格を持たない (日本人) 申込は null。
  residenceStatus   ResidenceStatus?
  // 申込時の希望職種（FacilityCategory の複数選択）。Phase 1-4 の希望整合度スコアで使用。
  desiredCategories FacilityCategory[] @default([])
  wantsDiagnosis    Boolean            @default(true)
  status            ApplicantStatus    @default(RECEIVED)
  qualifications    Qualification[]
  diagnoses         Diagnosis[]
  skillSheet        SkillSheet?
  skillSheetTokens  SkillSheetToken[]
  resumeUploads     ResumeUpload[]
  emailLogs         EmailLog[]
  interview         Interview?
  faxSheets         FaxSheet[]
  // Phase 6: 紹介成立 / 派遣台帳 / マイナンバー
  placements        Placement[]
  dispatchLedgers   DispatchLedger[]
  myNumberRecord    MyNumberRecord?
  // v1.8: ナーチャシナリオ
  nurtureSequences  NurtureSequence[]
  // v1.9: AI 出力レビュー
  aiReviews         AiReview[]
  deletedAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
}

model Qualification {
  id          String    @id @default(cuid())
  applicantId String
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  name        String
  acquiredOn  DateTime?
  number      String?

  @@index([applicantId])
}

model Diagnosis {
  id          String           @id @default(cuid())
  applicantId String
  applicant   Applicant        @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  category    FacilityCategory
  score       Int
  rank        Rank
  proComment  String
  conComment  String
  generatedAt DateTime         @default(now())

  @@unique([applicantId, category])
  @@index([rank])
}

model SkillSheet {
  id           String    @id @default(cuid())
  applicantId  String    @unique
  applicant    Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  educations   Json
  careers      Json
  skills       Json
  desired      Json
  selfPR       String?
  rawResumeKey String?
  // 求職者が「途中保存」した時刻。空なら未着手。
  savedAt      DateTime?
  // 求職者が「提出」した時刻 = SKILL_SHEET_DONE 相当。
  submittedAt  DateTime?
  completedAt  DateTime?
  // 直近の編集者 (自己入力 / OCR 取込 / スタッフ修正) の追跡用。
  lastEditedBy String? // "applicant" | "ocr" | "staff:<staffId>"
  updatedAt    DateTime  @updatedAt
}

model Interview {
  id          String           @id @default(cuid())
  applicantId String           @unique
  applicant   Applicant        @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  callSid     String?
  startedAt   DateTime?
  endedAt     DateTime?
  durationSec Int?
  transcript  String?
  summary     Json?
  audioKey    String?
  // Phase 3 で追加。"scheduled" | "in_progress" | "completed" | "failed"
  status      String           @default("scheduled")
  // 質問数 (interview.next-question を呼ぶたびにインクリメント)。最大値は INTERVIEW_MAX_TURNS。
  turnCount   Int              @default(0)
  channel     String? // "voice" (Twilio) | "text" (Simulator)
  provider    String? // "mock" | "twilio"
  language    String           @default("ja")
  turns       InterviewTurn[]
  tokens      InterviewToken[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model InterviewTurn {
  id          String    @id @default(cuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  turnIndex   Int
  // "ai" = AI による質問、"applicant" = 求職者の回答
  role        String
  text        String    @db.Text
  audioKey    String?
  // STT/TTS のプロバイダ名 (provider:model 形式可)。
  provider    String?
  createdAt   DateTime  @default(now())

  @@unique([interviewId, turnIndex])
  @@index([interviewId])
}

// 求職者向け面接ページの認証トークン。Interview 単位で発行する。
model InterviewToken {
  id          String    @id @default(cuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  token       String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  lastSeenAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([interviewId])
  @@index([expiresAt])
}

// ジョブキュー (BullMQ / メモリ) の実行ログ。リトライ・失敗追跡用。
model JobLog {
  id           String    @id @default(cuid())
  queue        String // "diagnosis" | "resume" | "interview"
  jobName      String // ジョブのキー (例: "diagnosis.generate")
  target       String? // ApplicantId / UploadId / InterviewId などのキー
  payload      Json?
  status       String    @default("queued") // "queued" | "active" | "completed" | "failed"
  attempts     Int       @default(0)
  errorMessage String?
  startedAt    DateTime?
  endedAt      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([queue, status])
  @@index([target])
  @@index([createdAt])
}

// =====================
// 求人施設・営業ドメイン
// =====================

model Facility {
  id              String                @id @default(cuid())
  name            String
  category        FacilityCategory
  prefecture      String
  city            String
  address         String
  fax             String?
  email           String?
  isFaxPublic     Boolean               @default(false)
  notes           String?
  // v1.8: 緯度経度 (Haversine 距離マッチング用、optional)
  lat             Float?
  lng             Float?
  faxSheets       FaxSheet[]
  reactions       FaxReaction[]
  // Phase 6: 求人案件 / 契約 / 請求書 / 紹介成立 / 派遣台帳 を Facility に紐付け
  jobOrders       JobOrder[]
  contracts       Contract[]
  invoices        Invoice[]
  placements      Placement[]
  dispatchLedgers DispatchLedger[]
  // v1.8: 施設ポータルトークン
  portalTokens    FacilityPortalToken[]
  createdAt       DateTime              @default(now())

  @@index([category])
  @@index([prefecture])
}

model FaxSheet {
  id          String       @id @default(cuid())
  applicantId String
  facilityId  String
  applicant   Applicant    @relation(fields: [applicantId], references: [id])
  facility    Facility     @relation(fields: [facilityId], references: [id])
  pdfKey      String
  sentAt      DateTime?
  channel     String // "FAX" | "EMAIL"
  status      String // "PENDING" | "SENT" | "FAILED"
  reaction    FaxReaction?
  createdAt   DateTime     @default(now())

  @@index([applicantId])
  @@index([facilityId])
  @@index([status])
}

model FaxReaction {
  id         String   @id @default(cuid())
  faxSheetId String   @unique
  facilityId String
  faxSheet   FaxSheet @relation(fields: [faxSheetId], references: [id], onDelete: Cascade)
  facility   Facility @relation(fields: [facilityId], references: [id])
  interested Boolean
  comment    String?
  receivedAt DateTime @default(now())

  @@index([facilityId])
}

// =====================
// 監査ログ
// =====================

model AuditLog {
  id        String   @id @default(cuid())
  staffId   String?
  staff     Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  action    String
  target    String?
  payload   Json?
  createdAt DateTime @default(now())

  @@index([staffId])
  @@index([createdAt])
  @@index([action])
}

// =====================
// Phase 2: スキルシート自動化関連
// =====================

// 求職者がメールリンクから自分のスキルシートを編集するためのトークン。
// 申込受付時に 1 件発行し、期限切れ・revoke で無効化する。
model SkillSheetToken {
  id          String    @id @default(cuid())
  applicantId String
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  token       String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  // 求職者がアクセスした最終時刻 (UX 用に保持。PII 観点では特に問題なし)。
  lastSeenAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([applicantId])
  @@index([expiresAt])
}

// 履歴書アップロード履歴。OCR ジョブの状態を保持し、SkillSheet にマージするまでを管理する。
model ResumeUpload {
  id           String    @id @default(cuid())
  applicantId  String
  applicant    Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  // ローカル storage キー (S3 に切替時もこのキーは利用)。
  fileKey      String
  mimeType     String
  bytes        Int
  // OCR の生テキスト (PII を含むので AI に渡す前にマスクする)。
  rawText      String?   @db.Text
  // Claude で構造化したスキルシート JSON。SkillSheet にマージする前段の保持先。
  parsedJson   Json?
  // OCR / 構造化のプロバイダ名 (mock / docai / claude 等)。
  ocrProvider  String?
  llmProvider  String?
  // "uploaded" | "ocr_running" | "ocr_done" | "ocr_failed" | "merged"
  status       String    @default("uploaded")
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([applicantId])
  @@index([status])
}

// 送信したメールの監査・再送・確認のための保管庫。
// 本文はサニタイズ前の生本文を保存しないこと (件名・概要・宛先マスクのみ)。
model EmailLog {
  id           String     @id @default(cuid())
  applicantId  String?
  applicant    Applicant? @relation(fields: [applicantId], references: [id], onDelete: SetNull)
  // 例: "applicant.receipt" / "applicant.skill_sheet_invite" / "staff.notification"
  template     String
  toMasked     String
  subject      String
  // 言語コード (ja / en / vi / id / zh)
  locale       String     @default("ja")
  provider     String     @default("mock")
  // .storage/sent-emails/<id>.eml に書き出した場合の相対パス。
  storedKey    String?
  status       String     @default("queued") // queued | sent | failed
  errorMessage String?
  sentAt       DateTime?
  createdAt    DateTime   @default(now())

  @@index([applicantId])
  @@index([template])
  @@index([status])
}

// =====================
// Phase 5: 在留資格 (外国人対応)
// =====================

// 外国人申込者の在留資格情報。Applicant と 1:1。
// 個人情報の中でも特に取扱注意なので、別エンティティに分離し権限を絞れるようにする。
model ResidenceStatus {
  id          String    @id @default(cuid())
  applicantId String    @unique
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  // 例: "ENGINEER" / "SSW1_CARE" / "SPECIFIED_SKILLED" / "PERMANENT" / "OTHER" 等
  visaType    String
  visaNumber  String?
  // 有効期限
  expireAt    DateTime?
  // 自由記述 (条件付き / 在留期間更新中等)
  notes       String?
  // Phase 6: 在留期限アラートの最終送信時刻 (重複送信防止)
  alertSentAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([visaType])
  @@index([expireAt])
}

// =====================
// Phase 6: 求人案件 / 契約 / 紹介成立 / 請求書 / 派遣台帳 / マイナンバー / 監査
// 詳細は docs/internal-system-spec.md を参照
// =====================

// 求人案件。施設は法人実体、案件は個別募集。FAX 一括送信や加重マッチングの単位はこちら。
model JobOrder {
  id                      String           @id @default(cuid())
  facilityId              String
  facility                Facility         @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  title                   String
  position                JobPosition
  employmentType          EmploymentType
  // 時給帯 (派遣・パート)。常勤は monthlyWage* を使う。
  hourlyWageMin           Int?
  hourlyWageMax           Int?
  monthlyWageMin          Int?
  monthlyWageMax          Int?
  // { dayShift: bool, nightShift: bool, oncall: bool, weeklyDays: int }
  shiftPattern            Json?
  requiredQualifications  String[]         @default([])
  preferredQualifications String[]         @default([])
  minExperienceYears      Int              @default(0)
  headcount               Int              @default(1)
  status                  JobOrderStatus   @default(OPEN)
  urgency                 JobOrderUrgency  @default(NORMAL)
  startDate               DateTime?
  endDate                 DateTime?
  nearestStation          String?
  lat                     Float?
  lng                     Float?
  notes                   String?
  placements              Placement[]
  dispatchLedgers         DispatchLedger[]
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  @@index([facilityId])
  @@index([status])
  @@index([position])
  @@index([urgency])
}

// 返金規定 (早期退職時の段階返金)。Contract 経由で Placement に適用。
model RefundPolicy {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  // [{ withinDays: 30, refundRate: 1.0 }, { withinDays: 60, refundRate: 0.5 }, ...]
  tiers       Json
  contracts   Contract[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// 取引契約 (施設との紹介・派遣契約)。
model Contract {
  id              String         @id @default(cuid())
  facilityId      String
  facility        Facility       @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  contractType    ContractType
  // 紹介手数料率 (年収 % または時給上乗せ % など)
  feeRate         Decimal        @db.Decimal(6, 4)
  refundPolicyId  String?
  refundPolicy    RefundPolicy?  @relation(fields: [refundPolicyId], references: [id])
  paymentTermDays Int            @default(60)
  startDate       DateTime
  endDate         DateTime?
  signedAt        DateTime?
  signedBy        String?
  eSignProvider   ESignProvider  @default(MOCK)
  eSignDocId      String?
  status          ContractStatus @default(DRAFT)
  placements      Placement[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([facilityId])
  @@index([status])
  @@index([startDate])
}

// 紹介成立 (Applicant × Facility × JobOrder × Contract)。
model Placement {
  id               String             @id @default(cuid())
  applicantId      String
  applicant        Applicant          @relation(fields: [applicantId], references: [id])
  facilityId       String
  facility         Facility           @relation(fields: [facilityId], references: [id])
  jobOrderId       String
  jobOrder         JobOrder           @relation(fields: [jobOrderId], references: [id])
  contractId       String
  contract         Contract           @relation(fields: [contractId], references: [id])
  startDate        DateTime
  endDate          DateTime?
  monthlyWage      Decimal            @db.Decimal(12, 2)
  introductionFee  Decimal            @db.Decimal(12, 2)
  feeStatus        PlacementFeeStatus @default(PENDING)
  refundDueDate    DateTime?
  attritionAt      DateTime?
  invoices         Invoice[]
  dispatchLedger   DispatchLedger?
  // v1.8: ナーチャシナリオ (入社後フォローアップ)
  nurtureSequences NurtureSequence[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([applicantId])
  @@index([facilityId])
  @@index([feeStatus])
  @@index([startDate])
}

// 請求書 (派遣費用 / 紹介手数料)。
model Invoice {
  id            String        @id @default(cuid())
  facilityId    String
  facility      Facility      @relation(fields: [facilityId], references: [id])
  placementId   String?
  placement     Placement?    @relation(fields: [placementId], references: [id])
  invoiceNumber String        @unique
  issuedAt      DateTime
  dueAt         DateTime
  paidAt        DateTime?
  amount        Decimal       @db.Decimal(12, 2)
  tax           Decimal       @db.Decimal(12, 2)
  totalAmount   Decimal       @db.Decimal(12, 2)
  status        InvoiceStatus @default(DRAFT)
  pdfKey        String?
  // freee / Money Forward のレコード ID
  externalId    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([facilityId])
  @@index([status])
  @@index([dueAt])
}

// 派遣台帳 (派遣業法対応)。Placement (EmploymentType=DISPATCH) ごとに 1 件。
// 抵触日 = dispatchPeriodStart + 3 年 - 1 日。
model DispatchLedger {
  id                      String    @id @default(cuid())
  placementId             String    @unique
  placement               Placement @relation(fields: [placementId], references: [id], onDelete: Cascade)
  // snapshot (Placement 削除/移動でも台帳は残せるよう)
  applicantId             String
  applicant               Applicant @relation(fields: [applicantId], references: [id])
  facilityId              String
  facility                Facility  @relation(fields: [facilityId], references: [id])
  jobOrderId              String
  jobOrder                JobOrder  @relation(fields: [jobOrderId], references: [id])
  antiteishokuDate        DateTime
  dispatchPeriodStart     DateTime
  dispatchPeriodEnd       DateTime
  dispatchManagerName     String
  receivingManagerName    String
  socialInsuranceEnrolled Boolean   @default(false)
  contractCount           Int       @default(1)
  notes                   String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([applicantId])
  @@index([facilityId])
  @@index([antiteishokuDate])
}

// マイナンバー (特定個人情報)。Applicant と 1:1。AES-256-GCM で encryptedNumber を保管。
// 復号は src/lib/compliance/my-number.ts 経由。アクセス時は MyNumberAccessLog に必ず記録。
model MyNumberRecord {
  id              String              @id @default(cuid())
  applicantId     String              @unique
  applicant       Applicant           @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  // "iv:tag:ciphertext" の hex packed 形式
  encryptedNumber String
  encryptedAt     DateTime            @default(now())
  purpose         MyNumberPurpose
  retentionUntil  DateTime
  deletedAt       DateTime?
  accessLogs      MyNumberAccessLog[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([purpose])
  @@index([retentionUntil])
  @@index([deletedAt])
}

model MyNumberAccessLog {
  id               String               @id @default(cuid())
  myNumberRecordId String
  myNumberRecord   MyNumberRecord       @relation(fields: [myNumberRecordId], references: [id], onDelete: Cascade)
  staffId          String
  staff            Staff                @relation(fields: [staffId], references: [id])
  action           MyNumberAccessAction
  reason           String
  ipAddress        String?
  accessedAt       DateTime             @default(now())

  @@index([myNumberRecordId])
  @@index([staffId])
  @@index([accessedAt])
}

// append-only ハッシュチェーン監査ログ。hash = sha256(prevHash || canonical(this)).
// 検証ジョブで連続区間の整合性を再計算 → 改ざん検知。
model AuditEvent {
  id           String   @id @default(cuid())
  actorStaffId String?
  actor        Staff?   @relation(fields: [actorStaffId], references: [id], onDelete: SetNull)
  // Staff 削除後も追跡できるよう snapshot
  actorEmail   String?
  action       String
  entityType   String
  entityId     String?
  before       Json?
  after        Json?
  ipAddress    String?
  userAgent    String?
  requestId    String?
  prevHash     String
  hash         String   @unique
  createdAt    DateTime @default(now())

  @@index([action])
  @@index([entityType, entityId])
  @@index([actorStaffId])
  @@index([createdAt])
}

// =====================
// v1.8: 施設ポータル / ナーチャシナリオ / 監査チェックポイント
// =====================

// 施設へ送る "ログイン不要" のポータルアクセストークン。HMAC で署名。
// 期限切れ・revoke 可能。1 施設に複数発行できる (営業担当別など)。
model FacilityPortalToken {
  id          String    @id @default(cuid())
  facilityId  String
  facility    Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  token       String    @unique
  label       String? // "8月配布分" など
  expiresAt   DateTime
  revokedAt   DateTime?
  lastSeenAt  DateTime?
  accessCount Int       @default(0)
  createdAt   DateTime  @default(now())
  createdBy   String? // Staff.id (誰が発行したか)

  @@index([facilityId])
  @@index([expiresAt])
}

// 自動化シナリオ。Applicant or Placement に紐付き、ステップを順次実行。
model NurtureSequence {
  id          String                 @id @default(cuid())
  applicantId String?
  applicant   Applicant?             @relation(fields: [applicantId], references: [id], onDelete: SetNull)
  placementId String?
  placement   Placement?             @relation(fields: [placementId], references: [id], onDelete: SetNull)
  trigger     NurtureTrigger
  status      NurtureStatus          @default(ACTIVE)
  // ステップ定義 (JSON): [{ kind, label, waitDays, emailTemplate?, todoMessage? }, ...]
  steps       Json
  currentStep Int                    @default(0)
  startedAt   DateTime               @default(now())
  nextRunAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  notes       String?
  executions  NurtureStepExecution[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([status])
  @@index([nextRunAt])
  @@index([trigger])
  @@index([applicantId])
}

model NurtureStepExecution {
  id         String          @id @default(cuid())
  sequenceId String
  sequence   NurtureSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  stepIndex  Int
  kind       NurtureStepKind
  executedAt DateTime        @default(now())
  result     String // "ok" | "skipped" | "failed:<reason>"
  payload    Json? // 送信した EmailMessage の概要など

  @@index([sequenceId])
  @@index([executedAt])
}

// 監査チェーンのチェックポイント。スナップショット時点までの整合性を保証する。
// verifyChainSince(checkpoint) で差分のみ検証 → スケール問題を回避。
model AuditCheckpoint {
  id             String   @id @default(cuid())
  // チェックポイント時点までに記録された AuditEvent の最終 hash
  lastEventHash  String
  // チェックポイント時点での AuditEvent 件数 (差分検証時に使う)
  eventCountAtCp Int
  // ノート (運用者の手動チェックポイント時の理由など)
  note           String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

// =====================
// v1.9: Responsible AI レビューワークフロー
// =====================

// AI が生成した出力に対する「人間の承認/編集/却下」を必ず通すための監査面。
// `before` は AI 生の出力、`after` は人間が直した最終公開版。
// 公開系 (FAX/メール/PDF 等) は status=APPROVED か EDITED でないと送信できない運用を強制する。
model AiReview {
  id              String         @id @default(cuid())
  kind            AiReviewKind
  applicantId     String?
  applicant       Applicant?     @relation(fields: [applicantId], references: [id], onDelete: SetNull)
  // 関連エンティティ (FaxSheet / EmailLog / Interview など)
  refEntityType   String?
  refEntityId     String?
  // AI 出力 (Markdown / Plain text / JSON 文字列のいずれか)
  aiOutput        String         @db.Text
  // 人間が編集した最終版 (EDITED 時のみ非 null)
  finalOutput     String?        @db.Text
  // AI provider が返した confidence (0-1)
  confidence      Float?
  // 公開前の bias eval 結果 (overall + findings JSON snapshot)
  biasEval        Json?
  status          AiReviewStatus @default(PENDING)
  reviewerStaffId String?
  reviewerStaff   Staff?         @relation(fields: [reviewerStaffId], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  reviewNote      String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
  @@index([kind])
  @@index([applicantId])
  @@index([refEntityType, refEntityId])
}
