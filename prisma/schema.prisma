// Phase 1-2: ドメインモデルを追加。Auth.js テーブルは Phase 1-1 から維持。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================
// Enums
// =====================

enum StaffRole {
  ADMIN
  CONSULTANT
  SALES
  VIEWER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Rank {
  S
  A
  B
  C
  D
}

enum ApplicantStatus {
  RECEIVED
  DIAGNOSED
  SKILL_SHEET_INPROGRESS
  SKILL_SHEET_DONE
  INTERVIEW_DONE
  SALES_READY
  IN_INTRODUCTION
  CONTRACTED
  REJECTED
}

enum FacilityCategory {
  HOSPITAL_ACUTE
  HOSPITAL_GENERAL
  CLINIC
  DAYCARE_ELDERLY
  REHAB_DAY
  HOMEVISIT_NURSE
  HOMEVISIT_NURSE_PSYCHIATRY
  HOMEVISIT_CARE
  DAYCARE_DISABILITY
  HOMEVISIT_DISABILITY
  GROUP_HOME_DISABILITY
}

// =====================
// Auth.js (NextAuth v5) 標準スキーマ
// 参考: https://authjs.dev/getting-started/adapters/prisma
// =====================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // Credentials Provider 用。Magic Link のみの利用者は null
  accounts      Account[]
  sessions      Session[]
  staff         Staff?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =====================
// 社内スタッフ
// =====================

// 社内スタッフの業務属性。User と 1:1。
model Staff {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String     @unique
  name      String
  role      StaffRole  @default(VIEWER)
  auditLogs AuditLog[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// =====================
// 求職者ドメイン
// =====================

model Applicant {
  id                String             @id @default(cuid())
  lastName          String
  firstName         String
  lastNameKana      String
  firstNameKana     String
  birthDate         DateTime
  gender            Gender
  email             String             @unique
  phone             String
  nationality       String?
  language          String?            @default("ja")
  // 申込時の希望職種（FacilityCategory の複数選択）。Phase 1-4 の希望整合度スコアで使用。
  desiredCategories FacilityCategory[] @default([])
  wantsDiagnosis    Boolean            @default(true)
  status            ApplicantStatus    @default(RECEIVED)
  qualifications    Qualification[]
  diagnoses         Diagnosis[]
  skillSheet        SkillSheet?
  skillSheetTokens  SkillSheetToken[]
  resumeUploads     ResumeUpload[]
  emailLogs         EmailLog[]
  interview         Interview?
  faxSheets         FaxSheet[]
  deletedAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
}

model Qualification {
  id          String    @id @default(cuid())
  applicantId String
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  name        String
  acquiredOn  DateTime?
  number      String?

  @@index([applicantId])
}

model Diagnosis {
  id          String           @id @default(cuid())
  applicantId String
  applicant   Applicant        @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  category    FacilityCategory
  score       Int
  rank        Rank
  proComment  String
  conComment  String
  generatedAt DateTime         @default(now())

  @@unique([applicantId, category])
  @@index([rank])
}

model SkillSheet {
  id           String    @id @default(cuid())
  applicantId  String    @unique
  applicant    Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  educations   Json
  careers      Json
  skills       Json
  desired      Json
  selfPR       String?
  rawResumeKey String?
  // 求職者が「途中保存」した時刻。空なら未着手。
  savedAt      DateTime?
  // 求職者が「提出」した時刻 = SKILL_SHEET_DONE 相当。
  submittedAt  DateTime?
  completedAt  DateTime?
  // 直近の編集者 (自己入力 / OCR 取込 / スタッフ修正) の追跡用。
  lastEditedBy String? // "applicant" | "ocr" | "staff:<staffId>"
  updatedAt    DateTime  @updatedAt
}

model Interview {
  id          String           @id @default(cuid())
  applicantId String           @unique
  applicant   Applicant        @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  callSid     String?
  startedAt   DateTime?
  endedAt     DateTime?
  durationSec Int?
  transcript  String?
  summary     Json?
  audioKey    String?
  // Phase 3 で追加。"scheduled" | "in_progress" | "completed" | "failed"
  status      String           @default("scheduled")
  // 質問数 (interview.next-question を呼ぶたびにインクリメント)。最大値は INTERVIEW_MAX_TURNS。
  turnCount   Int              @default(0)
  channel     String? // "voice" (Twilio) | "text" (Simulator)
  provider    String? // "mock" | "twilio"
  language    String           @default("ja")
  turns       InterviewTurn[]
  tokens      InterviewToken[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model InterviewTurn {
  id          String    @id @default(cuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  turnIndex   Int
  // "ai" = AI による質問、"applicant" = 求職者の回答
  role        String
  text        String    @db.Text
  audioKey    String?
  // STT/TTS のプロバイダ名 (provider:model 形式可)。
  provider    String?
  createdAt   DateTime  @default(now())

  @@unique([interviewId, turnIndex])
  @@index([interviewId])
}

// 求職者向け面接ページの認証トークン。Interview 単位で発行する。
model InterviewToken {
  id          String    @id @default(cuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  token       String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  lastSeenAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([interviewId])
  @@index([expiresAt])
}

// ジョブキュー (BullMQ / メモリ) の実行ログ。リトライ・失敗追跡用。
model JobLog {
  id           String    @id @default(cuid())
  queue        String // "diagnosis" | "resume" | "interview"
  jobName      String // ジョブのキー (例: "diagnosis.generate")
  target       String? // ApplicantId / UploadId / InterviewId などのキー
  payload      Json?
  status       String    @default("queued") // "queued" | "active" | "completed" | "failed"
  attempts     Int       @default(0)
  errorMessage String?
  startedAt    DateTime?
  endedAt      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([queue, status])
  @@index([target])
  @@index([createdAt])
}

// =====================
// 求人施設・営業ドメイン
// =====================

model Facility {
  id          String           @id @default(cuid())
  name        String
  category    FacilityCategory
  prefecture  String
  city        String
  address     String
  fax         String?
  email       String?
  isFaxPublic Boolean          @default(false)
  notes       String?
  faxSheets   FaxSheet[]
  reactions   FaxReaction[]
  createdAt   DateTime         @default(now())

  @@index([category])
  @@index([prefecture])
}

model FaxSheet {
  id          String       @id @default(cuid())
  applicantId String
  facilityId  String
  applicant   Applicant    @relation(fields: [applicantId], references: [id])
  facility    Facility     @relation(fields: [facilityId], references: [id])
  pdfKey      String
  sentAt      DateTime?
  channel     String // "FAX" | "EMAIL"
  status      String // "PENDING" | "SENT" | "FAILED"
  reaction    FaxReaction?
  createdAt   DateTime     @default(now())

  @@index([applicantId])
  @@index([facilityId])
  @@index([status])
}

model FaxReaction {
  id         String   @id @default(cuid())
  faxSheetId String   @unique
  facilityId String
  faxSheet   FaxSheet @relation(fields: [faxSheetId], references: [id], onDelete: Cascade)
  facility   Facility @relation(fields: [facilityId], references: [id])
  interested Boolean
  comment    String?
  receivedAt DateTime @default(now())

  @@index([facilityId])
}

// =====================
// 監査ログ
// =====================

model AuditLog {
  id        String   @id @default(cuid())
  staffId   String?
  staff     Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  action    String
  target    String?
  payload   Json?
  createdAt DateTime @default(now())

  @@index([staffId])
  @@index([createdAt])
  @@index([action])
}

// =====================
// Phase 2: スキルシート自動化関連
// =====================

// 求職者がメールリンクから自分のスキルシートを編集するためのトークン。
// 申込受付時に 1 件発行し、期限切れ・revoke で無効化する。
model SkillSheetToken {
  id          String    @id @default(cuid())
  applicantId String
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  token       String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  // 求職者がアクセスした最終時刻 (UX 用に保持。PII 観点では特に問題なし)。
  lastSeenAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([applicantId])
  @@index([expiresAt])
}

// 履歴書アップロード履歴。OCR ジョブの状態を保持し、SkillSheet にマージするまでを管理する。
model ResumeUpload {
  id           String    @id @default(cuid())
  applicantId  String
  applicant    Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  // ローカル storage キー (S3 に切替時もこのキーは利用)。
  fileKey      String
  mimeType     String
  bytes        Int
  // OCR の生テキスト (PII を含むので AI に渡す前にマスクする)。
  rawText      String?   @db.Text
  // Claude で構造化したスキルシート JSON。SkillSheet にマージする前段の保持先。
  parsedJson   Json?
  // OCR / 構造化のプロバイダ名 (mock / docai / claude 等)。
  ocrProvider  String?
  llmProvider  String?
  // "uploaded" | "ocr_running" | "ocr_done" | "ocr_failed" | "merged"
  status       String    @default("uploaded")
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([applicantId])
  @@index([status])
}

// 送信したメールの監査・再送・確認のための保管庫。
// 本文はサニタイズ前の生本文を保存しないこと (件名・概要・宛先マスクのみ)。
model EmailLog {
  id           String     @id @default(cuid())
  applicantId  String?
  applicant    Applicant? @relation(fields: [applicantId], references: [id], onDelete: SetNull)
  // 例: "applicant.receipt" / "applicant.skill_sheet_invite" / "staff.notification"
  template     String
  toMasked     String
  subject      String
  // 言語コード (ja / en / vi / id / zh)
  locale       String     @default("ja")
  provider     String     @default("mock")
  // .storage/sent-emails/<id>.eml に書き出した場合の相対パス。
  storedKey    String?
  status       String     @default("queued") // queued | sent | failed
  errorMessage String?
  sentAt       DateTime?
  createdAt    DateTime   @default(now())

  @@index([applicantId])
  @@index([template])
  @@index([status])
}
