# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/growlink

# --- Redis (BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Auth.js (NextAuth v5) ---
# `openssl rand -base64 32` 等で生成した値を設定する
AUTH_SECRET=change-me-to-a-random-string
# ベース URL。dev は http://localhost:3000、本番は https://...
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Magic Link (Resend) ---
# 未設定の場合、開発時はマジックリンクをコンソールに出力する
RESEND_API_KEY=
AUTH_EMAIL_FROM=noreply@growlink.local

# --- Anthropic Claude API (Phase 1-5 以降で使用) ---
ANTHROPIC_API_KEY=sk-ant-xxxx
MODEL_SMART=claude-sonnet-4-6
MODEL_FAST=claude-haiku-4-5

# --- Twilio (Phase 3 で使用) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=

# --- InterFAX (Phase 4 で使用) ---
INTERFAX_USER=
INTERFAX_PASS=

# --- Google Document AI (Phase 2 で使用) ---
GCP_DOCAI_PROJECT=
GCP_DOCAI_LOCATION=us
GCP_DOCAI_PROCESSOR_ID=

# --- ストレージ (Phase 2 以降で使用) ---
S3_BUCKET=growlink-dev

# --- Seed (任意) ---
SEED_ADMIN_EMAIL=admin@growlink.local
SEED_ADMIN_PASSWORD=growlink-admin-pass
