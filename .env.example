# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/growlink

# --- Redis (BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Auth.js (NextAuth v5) ---
# `openssl rand -base64 32` 等で生成した値を設定する
AUTH_SECRET=change-me-to-a-random-string
# ベース URL。dev は http://localhost:3000、本番は https://...
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Magic Link (Resend) ---
# 未設定の場合、開発時はマジックリンクをコンソールに出力する
RESEND_API_KEY=
AUTH_EMAIL_FROM=noreply@growlink.local

# --- アプリケーション URL (Phase 2: スキルシート招待リンクなどに使う) ---
# Cookie 名は固定 (growlink_locale)。空ならローカル http://localhost:3000 を使う。
APP_BASE_URL=http://localhost:3000

# --- メール送信 (Phase 2) ---
# "mock" (デフォルト): console.log + .storage/sent-emails/ に .eml を書き出し
# "resend"           : Resend に実送信 (RESEND_API_KEY が必要)
EMAIL_PROVIDER=mock
# 差出人と返信先 (mock でも EML に書き込む)
EMAIL_FROM=Growlink <no-reply@growlink.example>
EMAIL_REPLY_TO=support@growlink.example
# スタッフ通知メールの宛先 (新規申込通知など)
STAFF_NOTIFICATION_EMAIL=staff@growlink.example
# テスト用: EMAIL_PROVIDER=mock のとき、1 で意図的に失敗を返す
EMAIL_MOCK_FAIL=

# --- OCR (Phase 2) ---
# "mock"   (デフォルト): ハッシュベースで 3 種類の履歴書サンプルを返す
# "docai"               : Google Document AI (Phase 2 では未実装スタブ)
OCR_PROVIDER=mock

# --- ジョブキュー (Phase 3) ---
# "memory" (デフォルト): 同一プロセス setImmediate ベース。Redis 不要
# "bullmq"             : BullMQ + Redis (REDIS_URL を要求)
QUEUE_PROVIDER=memory
# WORKER_INLINE=1 で Next.js プロセスと同じ Node ランタイムでワーカも動かす
WORKER_INLINE=

# --- STT (Phase 3) ---
# "mock" (デフォルト): 質問インデックスごとに 3 種の固定回答を返す
# "whisper" / "deepgram": Phase 3 では未実装スタブ
STT_PROVIDER=mock

# --- TTS (Phase 3) ---
# "mock" (デフォルト): stub mp3 を .storage/tts/ に書き出す
# "elevenlabs" / "voicevox": Phase 3 では未実装スタブ
TTS_PROVIDER=mock

# --- Twilio Programmable Voice (Phase 3) ---
# "mock" (デフォルト): createCall は console.log のみ。実電話は飛ばない
# "twilio"           : 実 Twilio (TWILIO_* 必須)
TWILIO_PROVIDER=mock

# --- AI プロバイダ切替 ---
# "mock" (デフォルト): モック実装で API 課金なし。
# "anthropic"        : Claude API。ANTHROPIC_API_KEY 必須。
# "gemini"           : Google Gemini。GEMINI_API_KEY 必須。
AI_PROVIDER=mock

# --- Anthropic Claude API ---
ANTHROPIC_API_KEY=
MODEL_SMART=claude-sonnet-4-6
MODEL_FAST=claude-haiku-4-5

# --- Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL_SMART=gemini-2.5-pro
GEMINI_MODEL_FAST=gemini-2.5-flash

# --- Twilio (Phase 3 で使用) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=

# --- FAX 送信 ---
# "mock" (デフォルト): 送信は console.log のみ。実 FAX は飛ばない
# "interfax": InterFAX に実送信 (Phase 4 で実装)
FAX_PROVIDER=mock
# ローカル PDF 保存先 (FAX 送信票・診断書など)
STORAGE_DIR=.storage

# --- InterFAX (Phase 4 で使用) ---
INTERFAX_USER=
INTERFAX_PASS=

# --- Google Document AI (Phase 2 で使用) ---
GCP_DOCAI_PROJECT=
GCP_DOCAI_LOCATION=us
GCP_DOCAI_PROCESSOR_ID=

# --- ストレージ (Phase 2 以降で使用) ---
S3_BUCKET=growlink-dev

# --- Seed (任意) ---
SEED_ADMIN_EMAIL=admin@growlink.local
SEED_ADMIN_PASSWORD=growlink-admin-pass

# --- 監視 (Phase 5) ---
# 設定されている場合のみ Sentry に送信。未設定なら console に no-op。
SENTRY_DSN=

# --- v1.4 Phase 6: マイナンバー暗号化鍵 (AES-256-GCM, 32 byte = 64 hex chars) ---
# 本番では必ず KMS や Secrets Manager 経由で取得すること。.env にハードコード禁止。
# 生成例: openssl rand -hex 32
MYNUMBER_ENCRYPTION_KEY=
